# v13 本地默认：
# - api-enhanced 传统方式：npx @neteasecloudmusicapienhanced/api@latest，默认端口 3000
# - 本适配器：3017
#
# 注意：NCM_API_BASE 本地建议用 http://localhost:3000。
# 在 Vercel 上不要设置 localhost/127.0.0.1 的 NCM_API_BASE，v13 会自动忽略并切换 module 模式。

ADAPTER_PORT=3017
API_ENHANCED_PORT=3000
NCM_API_BASE=http://localhost:3000

# auto：本地优先 http；Vercel 自动 module，除非 NCM_API_BASE 是远程 https 地址。
# http：强制请求外部/本地 api-enhanced HTTP 服务。
# module：强制直接调用 @neteasecloudmusicapienhanced/api 模块，适合 Vercel。
PROVIDER_MODE=auto

NCM_LEVEL=standard
NCM_LEVELS=standard,higher,exhigh,lossless,hires
URL_STRATEGY=enhanced-only

# Cookie：本地如果 api-enhanced 已经从它自己的 .env 读到登录态，这里可空。
# Vercel module 模式建议填这两个。
NCM_MUSIC_U=
NCM_CSRF=

PLAYLIST_LIMIT=100
REQUEST_TIMEOUT=15000
DEBUG_RESPONSE=1

# 白名单。空表示不限制；建议本地先保留 localhost/127.0.0.1。
ALLOWLIST=
ALLOW_LOCAL=true
ALLOWLIST_DISABLED_DEFAULT=false

# 管理密码。管理员接口永远不受白名单拦截，但必须校验这个密码。
ADMIN_PASSWORD=
# Optional but recommended for tracks that your own account is entitled to play.
# Put this in Vercel Project Settings -> Environment Variables, not in Git.
# Example: MUSIC_U=xxx; __csrf=xxx; os=pc
NCM_COOKIE=

# Audio level requested from NeteaseCloudMusicApiEnhanced.
# standard | higher | exhigh | lossless | hires | jyeffect | sky | dolby | jymaster
# Availability depends on your account entitlement and upstream response.
NCM_LEVEL=exhigh

# Optional. If set, the adapter uses a separately deployed api-enhanced instance instead of the npm package.
# Example: https://your-api-enhanced.vercel.app
NCM_API_BASE=

# API allowlist. Used when Upstash Redis is not configured, or as fallback.
# One item per line or comma-separated.
# Supports: yuncan.xyz, https://yuncan.xyz, *.yuncan.xyz, 124.221.251.223, 120.85.43.0/24
ALLOWLIST=yuncan.xyz,*.yuncan.xyz

# Admin page password. Required for /admin/whitelist.
# Use a long random value and never commit it.
ADMIN_PASSWORD=

# Optional but recommended if you want the /admin page to persistently save whitelist changes.
# Vercel Marketplace Upstash Redis will usually inject these automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ALLOWLIST_REDIS_KEY=meting-enhanced:allowlist:v1

# Cache TTL in seconds. URL cache is intentionally short.
CACHE_TTL_JSON=300
CACHE_TTL_URL=60

# v0.17.0 配置示例
# 融合 api-enhanced 后, 不再需要 NCM_API_BASE / API_ENHANCED_PORT / PROVIDER_MODE
# 一个进程搞定, 无需启动外部 api-enhanced 服务

# 端口
ADAPTER_PORT=3017

# 音质 (standard / exhigh / lossless / hires)
NCM_LEVEL=standard
NCM_LEVELS=standard,exhigh,lossless,hires

# 解灰第一层 (api-enhanced 内置 unblockmusic-utils 6 模块)
ENABLE_GENERAL_UNBLOCK=true

# 解灰第二层 (直接调用 @unblockneteasemusic/server, 含 B 站音源 bilibili/bilivideo)
# 第一层未命中时启用, 补充 B 站等其他音源
ENABLE_EXTRA_UNBLOCK=true

# 第二层音源列表 (逗号分隔, 顺序即尝试顺序)
# 默认: B 站优先, 然后其他常用音源
EXTRA_UNBLOCK_SOURCES=bilibili,bilivideo,pyncmd,bodian,qq,kugou,kuwo,migu

# QQ 音乐 VIP 解灰 (v0.17.0+)
# QQ vkey 获取失败时, 用歌名+歌手跨平台匹配 酷狗/酷我/migu
# 注意: 不含 bilibili/bilivideo, B站音频 URL 需要 Referer 头, 客户端无法播放
QQ_UNBLOCK_ENABLED=true
# QQ 解灰音源 (逗号分隔)
QQ_UNBLOCK_SOURCES=kugou,kuwo,migu,pyncmd

# unblockmusic-utils 用: true 时降级为 320k/mp3, false 时尝试无损
DISABLE_FLAC=false

# 兜底策略: enhanced-only (默认) 或 enhanced-then-outer (失败时尝试 outer URL)
URL_STRATEGY=enhanced-only

# 登录态 (推荐通过环境变量配置, 不要写进 git)
# 留空则用游客模式 (VIP 歌曲通过解灰获取, 不保证一定成功)
NCM_MUSIC_U=
NCM_CSRF=
# 或者直接传完整 Cookie (优先级最高)
# NCM_COOKIE=MUSIC_U=xxx; __csrf=yyy; os=pc

# 播放列表/搜索限制
PLAYLIST_LIMIT=100
REQUEST_TIMEOUT=15000
DEBUG_RESPONSE=1

# 白名单 (空表示不限制; 本地保留 localhost/127.0.0.1)
# 支持域名 (含通配符 *.example.com)、IP、CIDR
# 示例: ALLOWLIST=example.com,*.example.com,1.2.3.4,10.0.0.0/8
ALLOWLIST=
ALLOW_LOCAL=true
ALLOWLIST_DISABLED_DEFAULT=false

# 管理密码 (管理员接口永远不受白名单拦截, 但必须校验)
# 用于 /admin 页面登录以及管理 API 的鉴权
ADMIN_PASSWORD=

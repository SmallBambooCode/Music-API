# v5 recommends split variables. This avoids import problems caused by semicolons/spaces.
NCM_MUSIC_U=
NCM_CSRF=

# Backward-compatible single cookie variable. If set, it overrides NCM_MUSIC_U/NCM_CSRF.
# NCM_COOKIE="MUSIC_U=xxx; __csrf=xxx; os=pc"
NCM_COOKIE=

# Audio levels. The adapter will try the preferred level first, then fallback levels.
NCM_LEVEL=standard
NCM_LEVELS=standard,higher,exhigh,lossless

# Optional. If set, the adapter uses a separately deployed api-enhanced instance instead of the npm package.
NCM_API_BASE=

# API allowlist. v5 ONLY reads allowlist rules from this env variable.
# One item per line or comma-separated.
ALLOWLIST=yuncan.xyz,*.yuncan.xyz

# Admin page password. Required for /admin.
ADMIN_PASSWORD=

# Optional test default. Do NOT enable in production unless you know what you are doing.
ALLOWLIST_DISABLED_DEFAULT=false

# Cache TTL in seconds. URL cache is intentionally short.
CACHE_TTL_JSON=300
CACHE_TTL_URL=45

# Optional. Old Meting-API endpoint used only as playback URL fallback.
# Example: https://old-meting-api.vercel.app/api
METING_FALLBACK_API=

# enhanced-then-fallback | fallback-first | fallback-only
# If your old API used to play reliably, set fallback-first after configuring METING_FALLBACK_API.
URL_PROVIDER=enhanced-then-fallback

# Optional. Set to 1 to include stack traces in 500 responses while debugging.
DEBUG_RESPONSE=0
